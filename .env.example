ENVIRONMENT="development"

SECRET_KEY="change-me-to-a-long-random-string"

ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

POSTGRES_URL="postgresql+asyncpg://user:password@localhost:5432/Barbershop"

FRONTEND_URL="http://localhost:3000"

# Object storage for barber avatars / portfolio photos (any S3-compatible provider).
# Uploads return HTTP 500 until these are filled in.
# S3_ENDPOINT_URL=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=

# SMTP for booking confirmation / cancellation emails.
# Without these, emails are just logged instead of sent.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_USE_TLS=true

# Stripe billing (test keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_MONTHLY="price_..."
STRIPE_PRICE_YEARLY="price_..."
STRIPE_TRIAL_DAYS=30
